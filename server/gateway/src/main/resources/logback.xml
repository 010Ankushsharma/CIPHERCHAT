<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for CipherChat gateway.

  Two appender profiles:
    CONSOLE (default/dev): human-readable colored output
    JSON (production):     structured JSON one-line-per-event for
                           log aggregation (Loki, Elasticsearch, etc.)

  Switch via LOG_FORMAT env var: LOG_FORMAT=json enables JSON output.
  In Docker Compose / Kubernetes, set LOG_FORMAT=json in the container
  environment and ship stdout to your log aggregator.
-->
<configuration>
    <property name="LOG_FORMAT" value="${LOG_FORMAT:-console}"/>

    <!-- Console appender: colored, human-readable for local dev -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{20}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- JSON appender: structured output for production log shipping -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter">
                    <prettyPrint>false</prettyPrint>
                </jsonFormatter>
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSX</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
            </layout>
        </encoder>
    </appender>

    <!-- Root logger: INFO in production, DEBUG if LOG_LEVEL=debug -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="${LOG_FORMAT:-CONSOLE}"/>
    </root>

    <!-- Reduce noise from Ktor's internal HTTP access log in dev -->
    <logger name="io.ktor.server.netty" level="WARN"/>
    <logger name="io.ktor.routing" level="WARN"/>

    <!-- Keep our own service loggers at INFO even if root is WARN -->
    <logger name="CipherChatGateway" level="INFO"/>
    <logger name="AuthService" level="INFO"/>
    <logger name="MessagingService" level="INFO"/>
    <logger name="WebSocketHandler" level="INFO"/>
    <logger name="PrekeyService" level="INFO"/>
</configuration>
